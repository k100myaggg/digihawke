---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const pathname = Astro.url.pathname;
// Remove trailing slash if any and split path into parts
const pathSegments = pathname.replace(/\/$/, '').split('/').filter(Boolean);

// Define custom human-readable labels for segments
const labels: Record<string, string> = {
  blog: 'Insights',
  about: 'About Us',
  services: 'Growth Systems',
  portfolio: 'Case Studies',
  contact: 'Contact & Audit',
  terms: 'Terms of Service',
  privacy: 'Privacy Policy',
  'privacy-smartstaff': 'SmartStaff Privacy Policy',
  disclaimer: 'Disclaimer',
};

// Build the trail of breadcrumb items
const breadcrumbs = [
  { label: 'Home', url: '/' },
  ...pathSegments.map((segment, index) => {
    const url = '/' + pathSegments.slice(0, index + 1).join('/');
    
    // Attempt to parse segment or format nicely
    let label = labels[segment] || segment;
    
    // Format slug-like names (like blog post titles) to Title Case
    if (!labels[segment] && segment.includes('-')) {
      label = segment
        .split('-')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    } else if (!labels[segment]) {
      label = segment.charAt(0).toUpperCase() + segment.slice(1);
    }
    
    return { label, url };
  })
];

// Generate JSON-LD BreadcrumbList structure
const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.label,
    "item": `https://digihawke.com${crumb.url}`
  }))
};
---

{pathSegments.length > 0 && (
  <nav aria-label="Breadcrumbs" class={`absolute top-24 left-0 w-full z-30 select-none ${className}`}>
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 flex items-center flex-wrap gap-2 text-xs font-sans font-medium text-on-surface-variant/80">
      {breadcrumbs.map((crumb, index) => {
        const isLast = index === breadcrumbs.length - 1;
        return (
          <div class="flex items-center gap-2">
            {index > 0 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-outline-variant/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            )}
            {isLast ? (
              <span class="text-white font-semibold truncate max-w-[240px] md:max-w-none" aria-current="page">
                {crumb.label}
              </span>
            ) : (
              <a 
                href={crumb.url} 
                class="hover:text-secondary transition-colors duration-200 border-b border-transparent hover:border-secondary/30 pb-0.5"
              >
                {crumb.label}
              </a>
            )}
          </div>
        );
      })}
    </div>

    <!-- Inject breadcrumb JSON-LD schema dynamically on the page -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbListSchema)} />
  </nav>
)}
