---
import Logo from './Logo.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Case Studies' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full glass-panel">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-16 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center focus-visible:outline-2 focus-visible:outline-secondary focus-visible:outline-offset-4 rounded-sm" aria-label="DigiHawke Media Home">
      <img 
        src="/images/logo-hawke.png?v=3" 
        alt="DigiHawke Media" 
        class="h-14 w-auto object-contain"
        width="70"
        height="56"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      <ul class="flex items-center gap-8 list-none m-0 p-0">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a 
                href={link.href} 
                class={`text-sm font-semibold tracking-wide hover:text-secondary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-secondary focus-visible:outline-offset-4 rounded-sm py-2 px-1 ${
                  isActive ? 'text-secondary font-bold text-glow-cyan' : 'text-on-surface-variant'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Desktop CTA Button -->
    <div class="hidden md:block">
      <a 
        href="/contact" 
        class="inline-flex items-center justify-center px-5 py-2.5 bg-primary text-background font-display font-extrabold text-sm rounded-[4px] glow-btn-primary select-none focus-visible:outline-2 focus-visible:outline-secondary focus-visible:outline-offset-4"
      >
        Get Free Audit
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn" 
      class="md:hidden flex items-center justify-center w-10 h-10 text-on-surface hover:text-secondary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-secondary rounded-sm"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Drawer (Hidden by default) -->
  <div 
    id="mobile-drawer" 
    class="hidden fixed inset-x-0 top-20 bg-background/95 backdrop-blur-lg border-b border-outline-variant transition-all duration-300 ease-in-out md:hidden"
    aria-label="Mobile Navigation"
  >
    <nav class="flex flex-col py-6 px-6 gap-6">
      <ul class="flex flex-col gap-4 list-none p-0 m-0">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a 
                href={link.href} 
                class={`block text-lg font-display font-semibold py-2 px-3 hover:text-secondary rounded-[4px] hover:bg-surface-container/50 transition-all ${
                  isActive ? 'text-secondary bg-surface-container/30 border-l-2 border-secondary' : 'text-on-surface-variant'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a 
        href="/contact" 
        class="w-full flex items-center justify-center py-3 bg-primary text-background font-display font-extrabold text-base rounded-[4px] glow-btn-primary"
      >
        Get Free Audit
      </a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const menuIcon = document.getElementById('menu-icon');

  if (menuBtn && drawer && menuIcon) {
    let isOpen = false;

    menuBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      menuBtn.setAttribute('aria-expanded', isOpen.toString());
      
      if (isOpen) {
        drawer.classList.remove('hidden');
        menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        drawer.classList.add('hidden');
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    });

    // Close drawer on window resize if layout switches to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        isOpen = false;
        menuBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    });
  }
</script>
