---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const serviceLinks = [
  { href: '/services', label: 'Search Engine Optimization' },
  { href: '/services', label: 'Performance Marketing (Google & Meta Ads)' },
  { href: '/services', label: 'Web & App Development' },
  { href: '/services', label: 'Video Editing Services' },
  { href: '/services', label: 'AI Tools & Automation' },
];

const companyLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Case Studies' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Book Consult' },
  { href: '/sitemap-index.xml', label: 'Sitemap' },
];

const socialLinks = [
  { 
    href: 'https://linkedin.com', 
    label: 'LinkedIn', 
    svg: `<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>` 
  },
  { 
    href: 'https://twitter.com', 
    label: 'Twitter / X', 
    svg: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>` 
  },
  { 
    href: 'https://instagram.com', 
    label: 'Instagram', 
    svg: `<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>` 
  },
];
---

<footer class="bg-surface-container-lowest border-t border-outline-variant pt-16 pb-8 px-6 lg:px-16" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
    
    <!-- Agency Summary -->
    <div class="flex flex-col gap-6">
      <a href="/" class="inline-block focus-visible:outline-2 focus-visible:outline-secondary rounded-sm" aria-label="DigiHawke Media Logo">
        <img 
          src="/images/logo-hawke.png?v=3" 
          alt="DigiHawke Media" 
          class="h-14 w-auto object-contain"
          width="70"
          height="56"
        />
      </a>
      <p class="text-sm text-on-surface-variant font-sans leading-relaxed">
        High-velocity digital marketing solutions designed to scale modern enterprises and high-growth startups. We engineer digital growth through strict, data-driven optimization.
      </p>
      
      <!-- Social Media Icons -->
      <div class="flex gap-4">
        {socialLinks.map((social) => (
          <a 
            href={social.href}
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-10 h-10 flex items-center justify-center rounded-sm bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-secondary border border-outline-variant hover:border-secondary/30 transition-all focus-visible:outline-2 focus-visible:outline-secondary"
            aria-label={`Visit our ${social.label} page`}
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true" set:html={social.svg} />
          </a>
        ))}
      </div>
    </div>

    <!-- Core Services Links -->
    <div class="flex flex-col gap-5">
      <h3 class="text-sm font-display font-bold text-white uppercase tracking-wider">Services</h3>
      <ul class="flex flex-col gap-3 list-none p-0 m-0 text-sm">
        {serviceLinks.map((link) => (
          <li>
            <a href={link.href} class="text-on-surface-variant hover:text-secondary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-secondary rounded-sm">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex flex-col gap-5">
      <h3 class="text-sm font-display font-bold text-white uppercase tracking-wider">Navigation</h3>
      <ul class="flex flex-col gap-3 list-none p-0 m-0 text-sm">
        {companyLinks.map((link) => (
          <li>
            <a href={link.href} class="text-on-surface-variant hover:text-secondary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-secondary rounded-sm">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Newsletter Sign-Up Form -->
    <div class="flex flex-col gap-5">
      <h3 class="text-sm font-display font-bold text-white uppercase tracking-wider">Stay Updated</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Receive cutting-edge marketing checklists, case studies, and insights directly in your inbox.
      </p>
      
      <form id="newsletter-form" class="flex flex-col gap-3" action="#" method="POST" aria-label="Newsletter Subscription Form">
        <div class="relative">
          <label for="newsletter-email" class="sr-only">Email Address</label>
          <input 
            type="email" 
            name="email"
            id="newsletter-email"
            placeholder="enter your email…"
            required
            autocomplete="email"
            spellcheck="false"
            class="w-full bg-surface-container-low border border-outline-variant rounded-[4px] px-4 py-3 text-sm text-white placeholder-on-surface-variant/50 focus:border-secondary focus:ring-1 focus:ring-secondary focus:outline-none transition-all"
          />
        </div>
        <button 
          type="submit" 
          id="newsletter-submit"
          class="w-full py-3 bg-primary text-background font-display font-extrabold text-sm rounded-[4px] glow-btn-primary cursor-pointer select-none transition-all flex items-center justify-center gap-2"
        >
          Subscribe
        </button>
        <p id="newsletter-feedback" class="hidden text-xs text-secondary mt-1 font-semibold" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- Bottom Details -->
  <div class="max-w-[1280px] mx-auto pt-8 border-t border-outline-variant flex flex-col lg:flex-row items-center justify-between gap-4 text-[10px] md:text-xs text-on-surface-variant font-sans">
    <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
      <span>&copy; {currentYear} DigiHawke Media. All rights reserved.</span>
      <span class="hidden md:inline text-outline-variant">|</span>
      <span>Office: <span class="text-white">Barhaj, Dist - Deoria , Gorakhpur. U.P - 274601</span></span>
      <span class="hidden md:inline text-outline-variant">|</span>
      <span>Email: <a href="mailto:help@digihawke.com" class="text-secondary hover:text-white transition-colors">help@digihawke.com</a></span>
    </div>
    <div class="flex gap-4">
      <a href="/privacy" class="hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary rounded-sm">Privacy Policy</a>
      <a href="/terms" class="hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary rounded-sm">Terms & Conditions</a>
      <a href="/disclaimer" class="hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary rounded-sm">Disclaimer</a>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const feedback = document.getElementById('newsletter-feedback');
  const submitBtn = document.getElementById('newsletter-submit');

  if (form && feedback && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const originalText = submitBtn.innerHTML;
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = 'Subscribing…';
      
      setTimeout(() => {
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = originalText;
        
        feedback.innerText = 'Thanks for subscribing! Check your inbox.';
        feedback.classList.remove('hidden');
        
        form.reset();
      }, 1500);
    });
  }
</script>
