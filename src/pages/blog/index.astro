---
import Layout from '../../layouts/Layout.astro';

const posts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];

// Sort by date descending
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});
---

<Layout 
  title="Digital Marketing Insights & Checklists | DigiHawke Media"
  description="Explore the latest search marketing tactics, paid acquisition insights, conversion optimization guidelines, and web development case studies."
>
  <!-- Blog Header -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-surface-container-lowest to-background relative overflow-hidden select-none" aria-label="Blog Header">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-surface-container-low),_transparent_70%)] pointer-events-none"></div>
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-secondary/20 bg-secondary/5 mb-6">
        <span class="text-[10px] font-display font-extrabold tracking-wider text-secondary uppercase">Growth Engineering Insights</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white tracking-tight mb-6 text-glow-indigo text-pretty">
        The DigiHawke Insights
      </h1>
      <p class="text-base md:text-lg text-on-surface-variant font-sans max-w-2xl mx-auto leading-relaxed">
        Articles, checklists, and guides on high-performance SEO, Paid PPC ad architectures, conversion optimization, and app store strategy.
      </p>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="py-16 bg-background relative z-10" aria-label="Insights Feed">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 mb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a 
            href={post.url} 
            class="group rounded-[8px] border border-outline-variant hover:border-secondary/30 bg-surface-container-lowest p-6 flex flex-col justify-between transition-all duration-300 hover:translate-y-[-4px] focus-visible:outline-2 focus-visible:outline-secondary"
            style="box-shadow: 0 10px 30px rgba(0,0,0,0.1);"
          >
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="px-2.5 py-0.5 rounded-full bg-secondary/10 border border-secondary/20 text-[10px] font-display font-extrabold text-secondary uppercase tracking-wider">
                  {post.frontmatter.categoryLabel || 'Article'}
                </span>
                <span class="text-[10px] font-mono text-on-surface-variant">
                  {post.frontmatter.date}
                </span>
              </div>
              
              <h2 class="text-xl font-display font-bold text-white mb-3 group-hover:text-secondary transition-colors line-clamp-2">
                {post.frontmatter.title}
              </h2>
              
              <p class="text-sm text-on-surface-variant leading-relaxed line-clamp-3 mb-6">
                {post.frontmatter.description}
              </p>
            </div>
            
            <div class="flex items-center justify-between border-t border-outline-variant/30 pt-4 text-xs font-semibold text-white">
              <span>Read Article</span>
              <svg class="w-4 h-4 text-secondary group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
