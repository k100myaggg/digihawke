---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import MetricCard from '../components/MetricCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true })) as any[];
const recentPosts = posts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);

const services = [
  {
    title: 'Search Engine Optimization',
    description: 'Command organic search grids. We audit search intent, build semantic core hubs, and secure authority links to drive non-paid pipelines.',
    features: ['Semantic intent clustering', 'Technical crawlability optimization', 'Editorial link acquisition', 'Content hub architectures'],
    icon: 'seo' as const,
  },
  {
    title: 'Performance Marketing (Google & Meta Ads)',
    description: 'Deploy capital where it converts. We engineer performance campaigns across Google, Meta, and LinkedIn with strict ROAS targets.',
    features: ['High-intent bidding architectures', 'Multi-variant creative testing', 'Custom audience segmentation', 'Dynamic retargeting funnel'],
    icon: 'ads' as const,
  },
  {
    title: 'Web & App Development',
    description: 'High-speed web platforms and custom mobile products. We construct lightning-fast static sites (Astro, Next.js) and build/publish Android apps end to end.',
    features: ['Astro static-site generation (SSG)', 'Android app design & development', 'Google Play Store publishing & ASO', 'Under 50ms server response speeds'],
    icon: 'dev' as const,
  },
  {
    title: 'Video Editing Services',
    description: 'Command viewer attention. We design and edit high-retention videos for social media campaigns, ads, and corporate channels using Premiere, After Effects, and CapCut.',
    features: ['High-retention social hooks & pacing', 'Adobe Premiere & After Effects editing', 'Engaging captions & motion graphics', 'Multi-platform video format optimization'],
    icon: 'video' as const,
  },
  {
    title: 'AI Tools & Automation',
    description: 'Scale operations, eliminate friction. We design custom AI agent workflows, integrate automated CRM triggers, and build custom LLM scrapers to save hundreds of hours.',
    features: ['Custom LLM & GPT agent workflow design', 'Automated CRM & lead trigger integrations', 'Intelligent web scraping & data mining', 'Operational workflow automation audits'],
    icon: 'automation' as const,
  },
];

const metrics = [
  { value: '+240%', label: 'Search Revenue Increase', details: 'Averaged across SEO accounts in 12 months.', percent: 94 },
  { value: '4.2x', label: 'Average ROAS Multiplier', details: 'Documented return on ad capital deployed.', percent: 88 },
  { value: '18,200+', label: 'Qualified MQLs Generated', details: 'High-intent leads captured for B2B/SaaS.', percent: 91 },
];

const testimonials = [
  {
    quote: "DigiHawke Media completely transformed our customer acquisition channel. Their SEO framework drove a 240% increase in search revenue, and the team operates with absolute transparency.",
    author: "Priya Sharma",
    role: "VP of Growth",
    company: "Apex E-Commerce",
    achievement: "+240% Search Revenue",
  },
  {
    quote: "Our Paid Social CPA was out of control. DigiHawke reconstructed our funnels and automated creative testing. They reduced our acquisition cost by 42% while doubling our volume.",
    author: "Rohan Mehta",
    role: "Chief Operating Officer",
    company: "SaaS Velocity",
    achievement: "-42% CPA Reduction",
  },
];
---

<Layout 
  title="DigiHawke | Digital Marketing Agency in Gorakhpur"
  metaTitle="Digital Marketing Agency in Gorakhpur - DigiHawke.com"
  description="DigiHawke Media is the leading digital marketing agency in Gorakhpur. We specialize in high-performance SEO, Paid PPC Ads, CRO, and App Development to scale your business. Contact us for a free growth audit today!"
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 md:pt-16 md:pb-28 overflow-hidden select-none" aria-label="Hero">
    <!-- Background Dot Pattern Accent -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-surface-container-low),_transparent_70%)] pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[radial-gradient(#4cd7f6_0.5px,_transparent_0.5px)] [background-size:24px_24px] opacity-10 pointer-events-none" aria-hidden="true"></div>
    
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
      <!-- Hero Left: Content -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Floating Accent Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-secondary/20 bg-secondary/5 mb-6 animate-pulse">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          <span class="text-[10px] font-display font-extrabold tracking-wider text-secondary uppercase">Velocity Scaling Engaged</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-[64px] font-display font-extrabold tracking-tight text-white leading-[1.1] mb-6 text-pretty text-glow-indigo">
          Accelerating Digital <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Revenue Capture</span>
        </h1>
        
        <p class="text-base md:text-lg text-on-surface-variant font-sans leading-relaxed mb-8 max-w-xl">
          DigiHawke Media is the leading digital marketing agency in Gorakhpur. We combine data-driven conversion frameworks with high-velocity traffic acquisition to drive pure financial yield.
        </p>
        
        <!-- CTA Actions -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a 
            href="/contact" 
            class="px-8 py-4 bg-primary text-background font-display font-extrabold text-sm rounded-[4px] glow-btn-primary text-center focus-visible:outline-2 focus-visible:outline-secondary"
          >
            Claim Free Revenue Audit
          </a>
          <a 
            href="/services" 
            class="px-8 py-4 border border-secondary text-secondary font-display font-extrabold text-sm rounded-[4px] glow-btn-secondary text-center focus-visible:outline-2 focus-visible:outline-secondary"
          >
            View Growth Systems
          </a>
        </div>
      </div>
      
      <!-- Hero Right: Interactive Dashboard Mockup Visual -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-[480px] rounded-[8px] glass-panel p-6 shadow-2xl relative overflow-hidden" style="box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
          <!-- Top Card Glow -->
          <div class="absolute -top-12 -left-12 w-24 h-24 bg-secondary/10 rounded-full blur-xl"></div>
          
          <!-- Mock Window Buttons -->
          <div class="flex gap-1.5 mb-6 border-b border-outline-variant/30 pb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-red/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-secondary/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-primary/60"></span>
            <span class="text-[10px] text-on-surface-variant/60 font-mono ml-4">digihawke-growth-matrix.conf</span>
          </div>
          
          <!-- Stat Grid -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-surface-container-low border border-outline-variant/50 rounded-[4px] p-3">
              <span class="text-[10px] text-on-surface-variant uppercase font-semibold tracking-wider">Acquisition ROAS</span>
              <div class="text-xl font-display font-extrabold text-white mt-1">4.82x</div>
              <div class="text-[10px] text-secondary font-bold mt-1">+14.2% vs baseline</div>
            </div>
            <div class="bg-surface-container-low border border-outline-variant/50 rounded-[4px] p-3">
              <span class="text-[10px] text-on-surface-variant uppercase font-semibold tracking-wider">Conversion rate</span>
              <div class="text-xl font-display font-extrabold text-white mt-1">3.92%</div>
              <div class="text-[10px] text-secondary font-bold mt-1">Double industry avg</div>
            </div>
          </div>
          
          <!-- Growth Chart Mock -->
          <div class="bg-surface-container-low border border-outline-variant/50 rounded-[4px] p-4 mb-4 flex flex-col justify-between h-40">
            <div class="flex items-center justify-between">
              <span class="text-xs font-display font-bold text-white">Monthly Organic Traffic</span>
              <span class="text-[10px] text-secondary font-extrabold bg-secondary/10 px-2 py-0.5 rounded-full uppercase">Live Engine</span>
            </div>
            
            <!-- Graphic Bars mimicking growth chart -->
            <div class="flex items-end gap-2.5 h-24 pt-4">
              <div class="w-full bg-surface-container-high rounded-t-sm h-[20%]"></div>
              <div class="w-full bg-surface-container-high rounded-t-sm h-[35%]"></div>
              <div class="w-full bg-surface-container-high rounded-t-sm h-[28%]"></div>
              <div class="w-full bg-surface-container-high rounded-t-sm h-[48%]"></div>
              <div class="w-full bg-primary/40 rounded-t-sm h-[60%] transition-all"></div>
              <div class="w-full bg-primary/70 rounded-t-sm h-[75%] transition-all"></div>
              <div class="w-full bg-secondary rounded-t-sm h-[95%] transition-all"></div>
            </div>
          </div>

          <!-- Bottom Metric -->
          <div class="flex items-center justify-between text-xs text-on-surface-variant">
            <span>Server Response latency</span>
            <span class="font-mono text-secondary">38ms (Ultra-Fast)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Banner -->
  <section class="py-8 bg-surface-container-lowest border-y border-outline-variant/30" aria-label="Brands We Scaled">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 flex flex-col items-center">
      <h2 class="text-[10px] font-display font-bold tracking-widest text-on-surface-variant/60 uppercase mb-6">
        TRUSTED BY LEADERS IN ENTERPRISE TECH & HIGH-VOLUME RETAIL
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-12 md:gap-20 opacity-50 select-none">
        <span class="font-display font-bold text-white text-base md:text-lg tracking-wider">APEX RETAIL</span>
        <span class="font-display font-bold text-white text-base md:text-lg tracking-wider">SAAS MATRIX</span>
        <span class="font-display font-bold text-white text-base md:text-lg tracking-wider">FINTECH LABS</span>
        <span class="font-display font-bold text-white text-base md:text-lg tracking-wider">CORE NEXUS</span>
      </div>
    </div>
  </section>

  <!-- Core Services Summary -->
  <section class="py-24 bg-background relative z-10" aria-labelledby="services-section-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 id="services-section-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
          Our Capabilities
        </h2>
        <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
          Built For Strict Commercial Conversion
        </p>
        <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
          We do not build templates. We design acquisition loops, deploy performance infrastructure, and construct organic pipelines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {services.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>

      <div class="text-center mt-12">
        <a 
          href="/services" 
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-secondary"
        >
          <span>View All Service Frameworks</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Our Process: The Velocity Formula -->
  <section class="py-24 bg-surface-container-lowest border-y border-outline-variant/30 relative overflow-hidden" aria-labelledby="process-section-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 id="process-section-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
          The Velocity Formula
        </h2>
        <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
          Our Systematic Growth Cycle
        </p>
        <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
          Scaling is a science, not a guessing game. Our iterative audit-to-optimize pipeline is engineered to continuously filter out friction.
        </p>
      </div>

      <!-- Process Node Steps -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
        <!-- Connecting Line for Desktop -->
        <div class="hidden md:block absolute top-[44px] left-[12%] right-[12%] h-0.5 bg-gradient-to-r from-primary/30 to-secondary/30 z-0"></div>

        <!-- Step 1 -->
        <div class="flex flex-col items-center text-center relative z-10 select-none">
          <div class="w-14 h-14 rounded-full bg-surface-container border-2 border-primary flex items-center justify-center mb-6 font-display font-extrabold text-lg text-primary shadow-[0_0_15px_rgba(195,192,255,0.2)]">
            01
          </div>
          <h3 class="text-lg font-display font-bold text-white mb-2">Omnichannel Audit</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed max-w-[220px]">
            We catalog your analytics, load metrics, copy conversions, and crawler blind spots.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col items-center text-center relative z-10 select-none">
          <div class="w-14 h-14 rounded-full bg-surface-container border-2 border-secondary flex items-center justify-center mb-6 font-display font-extrabold text-lg text-secondary shadow-[0_0_15px_rgba(76,215,246,0.2)]">
            02
          </div>
          <h3 class="text-lg font-display font-bold text-white mb-2">Intent Mapping</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed max-w-[220px]">
            Our strategists construct conversion maps, ad-capital matrix models, and content architectures.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center relative z-10 select-none">
          <div class="w-14 h-14 rounded-full bg-surface-container border-2 border-primary flex items-center justify-center mb-6 font-display font-extrabold text-lg text-primary shadow-[0_0_15px_rgba(195,192,255,0.2)]">
            03
          </div>
          <h3 class="text-lg font-display font-bold text-white mb-2">Precision Deployment</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed max-w-[220px]">
            We deploy structural SEO hierarchies, build fast web frameworks, and trigger high-intent ad funnels.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="flex flex-col items-center text-center relative z-10 select-none">
          <div class="w-14 h-14 rounded-full bg-surface-container border-2 border-secondary flex items-center justify-center mb-6 font-display font-extrabold text-lg text-secondary shadow-[0_0_15px_rgba(76,215,246,0.2)]">
            04
          </div>
          <h3 class="text-lg font-display font-bold text-white mb-2">Continuous Yield Test</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed max-w-[220px]">
            We execute rigorous split-run experiments on copy nodes, adjust ad groups, and monitor crawling logs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance Metrics Section -->
  <section class="py-24 bg-background" aria-labelledby="metrics-section-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 id="metrics-section-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
          Our Track Record
        </h2>
        <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
          Hard Data Behind Our Strategy
        </p>
        <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
          We run growth systems on absolute transparency. These metrics represent concrete commercial scale realized for client partners.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {metrics.map((metric) => (
          <MetricCard 
            value={metric.value} 
            label={metric.label} 
            details={metric.details} 
            progressPercent={metric.percent}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-24 bg-surface-container-lowest border-t border-outline-variant/30" aria-labelledby="testimonials-section-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 id="testimonials-section-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
          Client Endorsements
        </h2>
        <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
          Verified Performance Reviews
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.map((test) => (
          <TestimonialCard {...test} />
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Insights Section -->
  <section class="py-24 bg-surface-container-lowest border-t border-outline-variant/30 relative overflow-hidden" aria-labelledby="recent-insights-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
        <div class="max-w-2xl text-left">
          <h2 id="recent-insights-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
            Recent Insights
          </h2>
          <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
            Latest Marketing & Scaling Articles
          </p>
          <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
            Stay ahead of the curve with data-driven guides, local ranking parameters, and customer acquisition checklists.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a 
            href="/blog" 
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-secondary"
          >
            <span>View All Insights</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <a 
            href={post.url} 
            class="group rounded-[8px] border border-outline-variant hover:border-secondary/30 bg-surface-container p-6 flex flex-col justify-between transition-all duration-300 hover:translate-y-[-4px] focus-visible:outline-2 focus-visible:outline-secondary"
            style="box-shadow: 0 10px 30px rgba(0,0,0,0.15);"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-0.5 rounded-full bg-secondary/10 border border-secondary/20 text-[10px] font-display font-extrabold text-secondary uppercase tracking-wider">
                  {post.frontmatter.categoryLabel || 'Article'}
                </span>
                <span class="text-[10px] font-mono text-on-surface-variant">
                  {post.frontmatter.date}
                </span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-2 group-hover:text-secondary transition-colors line-clamp-2">
                {post.frontmatter.title}
              </h3>
              <p class="text-xs text-on-surface-variant leading-relaxed line-clamp-3 mb-6">
                {post.frontmatter.description}
              </p>
            </div>
            <div class="flex items-center justify-between border-t border-outline-variant/30 pt-4 text-xs font-semibold text-white">
              <span>Read Article</span>
              <svg class="w-4 h-4 text-secondary group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action Banner -->
  <section class="py-20 bg-background relative z-10" aria-label="Acquisition Banner">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="relative rounded-[8px] overflow-hidden glass-panel p-10 md:p-16 flex flex-col lg:flex-row items-center justify-between gap-10">
        <!-- Floating Ambient Glows -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-primary/10 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-secondary/15 rounded-full blur-2xl"></div>
        
        <div class="relative z-10 max-w-xl text-left">
          <h2 class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
            Ready to Capture Lost Conversion Opportunities?
          </h2>
          <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
            Stop letting prospects bounce to competitors. Claim your free omnichannel audit report and discover the exact technical optimizations to accelerate scaling.
          </p>
        </div>
        
        <div class="relative z-10 flex-shrink-0 w-full lg:w-auto flex flex-col sm:flex-row gap-4">
          <a 
            href="/contact" 
            class="px-8 py-4 bg-primary text-background font-display font-extrabold text-sm rounded-[4px] glow-btn-primary text-center focus-visible:outline-2 focus-visible:outline-secondary"
          >
            Claim Free Audit Report
          </a>
          <a 
            href="/portfolio" 
            class="px-8 py-4 border border-secondary text-secondary font-display font-extrabold text-sm rounded-[4px] glow-btn-secondary text-center focus-visible:outline-2 focus-visible:outline-secondary"
          >
            Read Case Studies
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-background relative z-10 border-t border-outline-variant/30" aria-labelledby="faq-section-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 id="faq-section-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
          Frequently Asked Questions
        </h2>
        <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-4 text-pretty text-glow-indigo">
          Expert Digital Marketing Insights
        </p>
        <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
          Have questions about scaling your business online? Here are answers from the leading digital marketing agency in Gorakhpur.
        </p>
      </div>

      <div class="max-w-[800px] mx-auto flex flex-col gap-6">
        <!-- FAQ 1 -->
        <div class="rounded-[8px] glass-panel p-6 border border-outline-variant/50 select-none">
          <h3 class="text-lg font-display font-bold text-white mb-2">What services does DigiHawke Media offer?</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            As a full-service digital marketing agency in Gorakhpur, DigiHawke Media offers high-performance SEO & Organic Growth, Paid PPC (Google/Meta/LinkedIn) Ads, Conversion Rate Optimization (CRO), and Enterprise Web/App Development.
          </p>
        </div>

        <!-- FAQ 2 -->
        <div class="rounded-[8px] glass-panel p-6 border border-outline-variant/50 select-none">
          <h3 class="text-lg font-display font-bold text-white mb-2">Why should I choose DigiHawke as my digital marketing agency in Gorakhpur?</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
