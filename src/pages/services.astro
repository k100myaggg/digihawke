---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const allServices = [
  {
    title: 'Search Engine Optimization',
    description: 'Command organic search grids. We audit search intent, build semantic core hubs, and secure authority links to drive non-paid pipelines.',
    features: [
      'Semantic keyword clustering & strategy',
      'Technical SEO & crawlability auditing',
      'High-authority backlink acquisition',
      'Content hub design & copywriting'
    ],
    icon: 'seo' as const,
  },
  {
    title: 'Performance Marketing (Google & Meta Ads)',
    description: 'Deploy capital where it converts. We engineer performance campaigns across Google, Meta, and LinkedIn with strict ROAS targets.',
    features: [
      'High-intent bidding architectures',
      'Multi-variant creative split testing',
      'Audience demographic segmentation',
      'Dynamic retargeting funnels'
    ],
    icon: 'ads' as const,
  },
  {
    title: 'Web & App Development',
    description: 'High-speed web platforms and custom mobile products. We construct lightning-fast static sites (Astro, Next.js) and build/publish Android apps end to end.',
    features: [
      'Astro static-site generation (SSG)',
      'Android app design & development',
      'Google Play Store publishing & ASO',
      'Under 50ms server response speeds'
    ],
    icon: 'dev' as const,
  },
  {
    title: 'Video Editing Services',
    description: 'Command viewer attention. We design and edit high-retention videos for social media campaigns, ads, and corporate channels using Premiere, After Effects, and CapCut.',
    features: [
      'High-retention social media hooks & pacing',
      'Adobe Premiere & After Effects editing',
      'Engaging captions & custom motion graphics',
      'Multi-platform video format optimization'
    ],
    icon: 'video' as const,
  },
  {
    title: 'AI Tools & Automation',
    description: 'Scale operations, eliminate friction. We design custom AI agent workflows, integrate automated CRM triggers, and build custom LLM scrapers to save hundreds of hours.',
    features: [
      'Custom LLM & GPT agent workflow design',
      'Automated CRM & lead trigger integrations',
      'Intelligent web scraping & data mining',
      'Operational workflow automation audits'
    ],
    icon: 'automation' as const,
  },
];
---

<Layout 
  title="Digital Marketing Services & App Development | DigiHawke Media"
  description="Explore our services: SEO, Paid Ads (PPC), CRO, Social Media Branding, Web Development, and Android App Development with Play Store Publishing."
>
  <!-- Services Header -->
  <section class="pt-12 pb-12 md:pt-16 md:pb-16 bg-gradient-to-b from-surface-container-lowest to-background relative overflow-hidden select-none" aria-label="Services Header">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-surface-container-low),_transparent_70%)] pointer-events-none"></div>
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-secondary/20 bg-secondary/5 mb-6">
        <span class="text-[10px] font-display font-extrabold tracking-wider text-secondary uppercase">Proven Conversion Frameworks</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white tracking-tight mb-6 text-glow-indigo text-pretty">
        High-Performance Growth Systems
      </h1>
      <p class="text-base md:text-lg text-on-surface-variant font-sans max-w-2xl mx-auto leading-relaxed">
        We map digital infrastructure directly to commercial growth. Compare our modular capabilities below or customize your channel layout to forecast potential return on investment.
      </p>
    </div>
  </section>

  <!-- Detailed Service Cards Grid -->
  <section class="py-16 bg-background relative z-10" aria-label="Our Service Channels">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allServices.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Dynamic Budget & Lead Estimator Widget -->
  <section class="py-24 bg-surface-container-lowest border-y border-outline-variant/30" aria-labelledby="estimator-title">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Estimator Info Left -->
        <div class="lg:col-span-5 text-left">
          <h2 id="estimator-title" class="text-xs font-display font-bold tracking-widest text-secondary uppercase mb-3">
            Growth Forecasting
          </h2>
          <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight mb-6 text-glow-indigo text-pretty">
            Channel Strategy & Budget Builder
          </p>
          <p class="text-sm md:text-base text-on-surface-variant leading-relaxed mb-6">
            Configure your target marketing channels and budget slider. Our interactive forecasting engine calculates estimated metrics based on verified industry benchmarks and past campaign performance.
          </p>
          <div class="p-4 rounded-[4px] bg-surface-container border border-outline-variant text-xs text-on-surface-variant leading-relaxed">
            <strong class="text-white">Note:</strong> Calculated estimates are projections. Book a free revenue audit to receive an exact data-backed model tailored to your competition.
          </div>
        </div>

        <!-- Estimator Interactive Calculator Right -->
        <div class="lg:col-span-7">
          <div class="rounded-[8px] glass-panel p-6 md:p-8 shadow-xl select-none">
            
            <!-- Step 1: Select Channels -->
            <div class="mb-8">
              <h3 class="text-sm font-display font-bold text-white uppercase tracking-wider mb-4">
                1. Select Marketing Channels
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- SEO Checkbox -->
                <label class="flex items-center gap-3 p-3 bg-surface-container-low hover:bg-surface-container border border-outline-variant hover:border-secondary/30 rounded-[4px] cursor-pointer transition-all">
                  <input 
                    type="checkbox" 
                    id="calc-seo" 
                    checked 
                    class="w-4 h-4 rounded-sm border-outline-variant text-secondary bg-background focus:ring-secondary focus:ring-offset-0 focus:outline-none"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">SEO & Organic Content</span>
                    <span class="text-[10px] text-on-surface-variant">High-volume organic visibility</span>
                  </div>
                </label>

                <!-- Paid Ads Checkbox -->
                <label class="flex items-center gap-3 p-3 bg-surface-container-low hover:bg-surface-container border border-outline-variant hover:border-secondary/30 rounded-[4px] cursor-pointer transition-all">
                  <input 
                    type="checkbox" 
                    id="calc-ads" 
                    checked 
                    class="w-4 h-4 rounded-sm border-outline-variant text-secondary bg-background focus:ring-secondary focus:ring-offset-0 focus:outline-none"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">PPC & Paid Social</span>
                    <span class="text-[10px] text-on-surface-variant">Instant customer acquisition</span>
                  </div>
                </label>

                <!-- Video Editing Checkbox -->
                <label class="flex items-center gap-3 p-3 bg-surface-container-low hover:bg-surface-container border border-outline-variant hover:border-secondary/30 rounded-[4px] cursor-pointer transition-all">
                  <input 
                    type="checkbox" 
                    id="calc-video" 
                    class="w-4 h-4 rounded-sm border-outline-variant text-secondary bg-background focus:ring-secondary focus:ring-offset-0 focus:outline-none"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">Video Editing</span>
                    <span class="text-[10px] text-on-surface-variant">High-retention social creatives</span>
                  </div>
                </label>

                <!-- Web Dev Checkbox -->
                <label class="flex items-center gap-3 p-3 bg-surface-container-low hover:bg-surface-container border border-outline-variant hover:border-secondary/30 rounded-[4px] cursor-pointer transition-all">
                  <input 
                    type="checkbox" 
                    id="calc-dev" 
                    class="w-4 h-4 rounded-sm border-outline-variant text-secondary bg-background focus:ring-secondary focus:ring-offset-0 focus:outline-none"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">Enterprise Web Dev</span>
                    <span class="text-[10px] text-on-surface-variant">Fast speeds & low bounce</span>
                  </div>
                </label>

                <!-- AI Tools & Automation Checkbox -->
                <label class="flex items-center gap-3 p-3 bg-surface-container-low hover:bg-surface-container border border-outline-variant hover:border-secondary/30 rounded-[4px] cursor-pointer transition-all">
                  <input 
                    type="checkbox" 
                    id="calc-automation" 
                    class="w-4 h-4 rounded-sm border-outline-variant text-secondary bg-background focus:ring-secondary focus:ring-offset-0 focus:outline-none"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">AI Tools & Automation</span>
                    <span class="text-[10px] text-on-surface-variant">Custom workflows & agent systems</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- Step 2: Budget Slider -->
            <div class="mb-8">
              <div class="flex justify-between items-center mb-3">
                <label for="calc-budget" class="text-sm font-display font-bold text-white uppercase tracking-wider">
                  2. Monthly Ad / Strategy Budget
                </label>
                <span class="text-lg font-mono font-bold text-secondary tabular-nums" id="budget-value">
                  ₹50,000
                </span>
              </div>
              <input 
                type="range" 
                id="calc-budget" 
                min="10000" 
                max="250000" 
                step="5000" 
                value="50000"
                class="w-full h-1.5 bg-surface-container-high rounded-full appearance-none cursor-pointer focus:outline-none focus:ring-0 accent-secondary"
              />
              <div class="flex justify-between text-[10px] text-on-surface-variant mt-2 font-mono">
                <span>₹10,000</span>
                <span>₹1,25,000</span>
                <span>₹2,50,000+</span>
              </div>
            </div>

            <!-- Step 3: Calculation Output Display -->
            <div class="bg-surface-container-low border border-outline-variant rounded-[4px] p-6 text-center">
              <div class="text-[10px] text-on-surface-variant uppercase font-semibold tracking-widest mb-2">
                Estimated Monthly Revenue Pipeline Boost
              </div>
              <div class="text-3xl md:text-4xl font-display font-extrabold text-secondary text-glow-cyan mb-4 font-mono tabular-nums" id="calc-result">
                ₹1,85,000
              </div>
              
              <!-- Metric breakdown details -->
              <div class="grid grid-cols-2 gap-4 border-t border-outline-variant/30 pt-4 text-left">
                <div>
                  <span class="text-[10px] text-on-surface-variant uppercase block font-semibold">Expected Leads / Mo</span>
                  <span class="text-sm font-mono font-bold text-white tabular-nums" id="calc-leads">84</span>
                </div>
                <div>
                  <span class="text-[10px] text-on-surface-variant uppercase block font-semibold">Projected Traffic Growth</span>
                  <span class="text-sm font-mono font-bold text-white tabular-nums" id="calc-traffic">+140%</span>
                </div>
              </div>
            </div>

            <!-- Call to Action inside panel -->
            <div class="mt-6">
              <a 
                href="/contact" 
                class="w-full flex items-center justify-center py-3 bg-primary text-background font-display font-extrabold text-sm rounded-[4px] glow-btn-primary"
              >
                Claim This Strategy Outlines
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const seoCheck = document.getElementById('calc-seo') as HTMLInputElement;
  const adsCheck = document.getElementById('calc-ads') as HTMLInputElement;
  const videoCheck = document.getElementById('calc-video') as HTMLInputElement;
  const devCheck = document.getElementById('calc-dev') as HTMLInputElement;
  const autoCheck = document.getElementById('calc-automation') as HTMLInputElement;
  const budgetRange = document.getElementById('calc-budget') as HTMLInputElement;
  
  const budgetVal = document.getElementById('budget-value');
  const calcResult = document.getElementById('calc-result');
  const calcLeads = document.getElementById('calc-leads');
  const calcTraffic = document.getElementById('calc-traffic');

  const updateCalculations = () => {
    if (!budgetRange || !budgetVal || !calcResult || !calcLeads || !calcTraffic) return;

    const budget = parseFloat(budgetRange.value);
    
    // Update budget text display with Indian grouping
    budgetVal.textContent = `₹${budget.toLocaleString('en-IN')}`;

    // Compute coefficients based on channel check state
    let multiplier = 0;
    let leadsCoefficient = 0.0012; // Adjusted for larger Indian budgets
    let trafficBoost = 0;

    if (seoCheck?.checked) {
      multiplier += 1.8;
      leadsCoefficient += 0.0003;
      trafficBoost += 90;
    }
    if (adsCheck?.checked) {
      multiplier += 2.2;
      leadsCoefficient += 0.0005;
      trafficBoost += 50;
    }
    if (videoCheck?.checked) {
      multiplier += 1.6;
      leadsCoefficient += 0.0003;
      trafficBoost += 15;
    }
    if (devCheck?.checked) {
      multiplier += 1.2;
      leadsCoefficient += 0.0002;
      trafficBoost += 30;
    }
    if (autoCheck?.checked) {
      multiplier += 2.0;
      leadsCoefficient += 0.0006;
      trafficBoost += 20;
    }

    // Default fallbacks if no channels checked
    if (multiplier === 0) {
      calcResult.textContent = '₹0';
      calcLeads.textContent = '0';
      calcTraffic.textContent = '+0%';
      return;
    }

    // Calculations
    const calculatedRevenue = budget * multiplier;
    const calculatedLeads = Math.round(budget * leadsCoefficient);
    const calculatedTraffic = trafficBoost;

    // Transition values elegantly with formatting
    calcResult.textContent = `₹${Math.round(calculatedRevenue).toLocaleString('en-IN')}`;
    calcLeads.textContent = calculatedLeads.toString();
    calcTraffic.textContent = `+${calculatedTraffic}%`;
  };

  // Attach event listeners
  [seoCheck, adsCheck, videoCheck, devCheck, autoCheck].forEach((checkbox) => {
    checkbox?.addEventListener('change', updateCalculations);
  });
  budgetRange?.addEventListener('input', updateCalculations);

  // Run initial calculation on load
  updateCalculations();
</script>
