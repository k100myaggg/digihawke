---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    author: string;
    category?: string;
    categoryLabel?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout 
  title={`${frontmatter.title} | DigiHawke Media`}
  description={frontmatter.description}
>
  <!-- Reading Progress Bar -->
  <div class="fixed top-20 left-0 right-0 h-1 bg-surface-container-high z-50 pointer-events-none">
    <div id="reading-progress" class="h-full bg-secondary w-0 transition-all duration-75"></div>
  </div>

  <section class="pt-32 pb-24 bg-gradient-to-b from-surface-container-lowest to-background relative overflow-hidden select-none">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-surface-container-low),_transparent_70%)] pointer-events-none"></div>
    
    <div class="max-w-[800px] mx-auto px-6 relative z-10 text-left">
      <!-- Back Link -->
      <a 
        href="/blog" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-secondary hover:text-white transition-colors mb-8 focus-visible:outline-2 focus-visible:outline-secondary"
      >
        <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
        <span>Back to Insights</span>
      </a>

      <!-- Category Tag -->
      {frontmatter.categoryLabel && (
        <span class="inline-block px-3 py-1 rounded-full bg-secondary/15 border border-secondary/20 text-[10px] font-display font-extrabold tracking-wider text-secondary uppercase mb-4">
          {frontmatter.categoryLabel}
        </span>
      )}

      <h1 class="text-3xl md:text-5xl font-display font-extrabold text-white leading-tight mb-6 text-glow-indigo text-pretty">
        {frontmatter.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-on-surface-variant font-mono mb-12 border-b border-outline-variant/30 pb-6">
        <span>By <strong class="text-white">{frontmatter.author}</strong></span>
        <span class="text-outline-variant">|</span>
        <span>{frontmatter.date}</span>
      </div>

      <!-- Article Content Wrapper -->
      <article class="prose prose-invert max-w-none text-sm md:text-base text-on-surface-variant leading-relaxed font-sans flex flex-col gap-6">
        <slot />
      </article>

      <!-- Social / Action Section -->
      <div class="mt-16 pt-8 border-t border-outline-variant/30 flex flex-wrap justify-between items-center gap-6">
        <a 
          href="/contact" 
          class="px-6 py-3 bg-primary text-background font-display font-extrabold text-xs rounded-[4px] glow-btn-primary focus-visible:outline-2 focus-visible:outline-secondary"
        >
          Claim Free Scaling Audit
        </a>
        <button 
          id="share-article-btn"
          class="inline-flex items-center gap-2 px-4 py-3 bg-surface-container hover:bg-surface-container-high border border-outline-variant text-xs font-semibold text-white rounded-[4px] cursor-pointer transition-all focus-visible:outline-2 focus-visible:outline-secondary"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 10.742l4.636-2.318a3 3 0 100-3.848l-4.636 2.318a3 3 0 100 3.848zm0 2.516l4.636 2.318a3 3 0 100 3.848l-4.636-2.318a3 3 0 100-3.848z" />
          </svg>
          <span>Share Article</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Reading Progress Script -->
  <script is:inline>
    const progressEl = document.getElementById('reading-progress');
    const shareBtn = document.getElementById('share-article-btn');

    // Update progress bar on scroll
    window.addEventListener('scroll', () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollHeight > 0) {
        const scrolled = (window.scrollY / scrollHeight) * 100;
        if (progressEl) progressEl.style.width = scrolled + '%';
      }
    });

    // Handle Native Share API
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        if (navigator.share) {
          navigator.share({
            title: document.title,
            text: 'Check out this digital marketing article from DigiHawke Media!',
            url: window.location.href,
          }).catch(console.error);
        } else {
          navigator.clipboard.writeText(window.location.href);
          alert('Article URL copied to clipboard!');
        }
      });
    }
  </script>
</Layout>

<style is:global>
  /* prose overrides for standard Markdown formatting */
  .prose h2 {
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .prose h3 {
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
    color: var(--color-on-surface-variant);
  }
  .prose strong {
    color: #ffffff;
    font-weight: 600;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prose li {
    list-style-type: disc;
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    border-left-width: 4px;
    border-left-color: var(--color-secondary);
    padding-left: 1rem;
    font-style: italic;
    margin: 1.5rem 0;
    color: #ffffff;
    background-color: var(--color-surface-container);
    padding: 1rem;
    border-radius: 4px;
  }
</style>
